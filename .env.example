# DeepL API Configuration
# Get your API key from: https://www.deepl.com/pro-api

# Your DeepL API authentication key
DEEPL_API_KEY=your_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_api_key_here' with your actual DeepL API key
# 3. Never commit the .env file to version control

# Optional (web app only)
# FLASK_SECRET_KEY=change_me_to_a_long_random_string
# FLASK_DEBUG=1
